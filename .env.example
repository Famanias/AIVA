# =============================================================================
# AIVA — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Database & Auth)
# https://app.supabase.com → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Redis (Queue)
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# LLM Provider
# Set LLM_PROVIDER to one of: gemini | groq | openrouter
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# LLM model names (configurable — never hardcoded)
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=google/gemini-flash-1.5

# -----------------------------------------------------------------------------
# Web Search (Research Agent)
# Set SEARCH_PROVIDER to one of: tavily | brave | serpapi
# -----------------------------------------------------------------------------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your-tavily-api-key
BRAVE_SEARCH_API_KEY=your-brave-api-key
SERPAPI_KEY=your-serpapi-key

# -----------------------------------------------------------------------------
# TTS (Voice Generation)
# Set TTS_PROVIDER to one of: kokoro | coqui | edge_tts
# -----------------------------------------------------------------------------
TTS_PROVIDER=kokoro
# Kokoro/Coqui run locally — no API key needed
# Cloud fallback:
EDGE_TTS_VOICE=en-US-AriaNeural

# -----------------------------------------------------------------------------
# Stock Media (B-Roll)
# -----------------------------------------------------------------------------
PEXELS_API_KEY=your-pexels-api-key
PIXABAY_API_KEY=your-pixabay-api-key

# -----------------------------------------------------------------------------
# Image Generation
# Set IMAGE_PROVIDER to one of: cloudflare | sdxl_local
# -----------------------------------------------------------------------------
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_WORKERS_AI_TOKEN=your-cf-token

# -----------------------------------------------------------------------------
# Storage
# Set STORAGE_PROVIDER to one of: supabase | s3
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=supabase
# S3-compatible (if not using Supabase Storage):
S3_ENDPOINT=https://your-s3-endpoint.com
S3_BUCKET=aiva-assets
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Template Renderer (Node.js Remotion worker)
# -----------------------------------------------------------------------------
TEMPLATE_RENDERER_URL=http://localhost:3001
CHROMIUM_POOL_SIZE=4
TEMPLATE_OUTPUT_CODEC=vp9

# -----------------------------------------------------------------------------
# Worker API (Python FastAPI)
# -----------------------------------------------------------------------------
WORKER_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Security
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
DATABASE_ENCRYPTION_KEY=replace-with-32-byte-hex-key

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
